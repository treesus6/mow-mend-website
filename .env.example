# GEMINI_API_KEY: Optional in this app; injected automatically by AI Studio if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public base URL where the site is hosted (used for sitemap/canonical links).
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional API key for sending instant email alerts to the owner on new estimate leads.
# Leave unset if email notifications are not configured yet.
RESEND_API_KEY=""

# OWNER_NOTIFICATION_EMAIL: Optional override for owner lead alerts (defaults to treevanderveer@gmail.com).
OWNER_NOTIFICATION_EMAIL="treevanderveer@gmail.com"

# RESEND_FROM_EMAIL: Verified sender address in Resend (e.g. "Mow & Mend Leads <leads@mowandmend.example>").
RESEND_FROM_EMAIL=""

# OWNER_DASHBOARD_EMAIL: Verified Google account email authorized for /admin access.
OWNER_DASHBOARD_EMAIL="treevanderveer@gmail.com"

